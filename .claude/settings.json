{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just --list)",
      "Bash(just check)",
      "Bash(just test)",
      "Bash(uv run --locked --offline python -m unittest:*)",
      "Bash(uv run --locked --offline python -m compileall:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(nvidia-smi:*)",
      "Bash(pgrep:*)",
      "Bash(ps -p:*)"
    ],
    "ask": [
      "Bash(just install)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(codex:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Edit(./.local/gpu.lock)"
    ]
  }
}
